# scripts/ — bastion-only ops scripts (e.g. invite_user.py)
#
# NEVER copy this to a laptop, CI runner, or any app container. SUPABASE_SECRET_KEY bypasses
# every Row Level Security policy (rule 4, PLAN.md §10.1). It is used only from the bastion
# host, by hand, to create login accounts; roles and berkas membership are then granted
# inside the app by a Super Admin (public.add_tenant_member), not by this script.
#
# Get the secret key from Supabase Dashboard → Project Settings → API → "sb_secret_..." key
# (self-hosted: the SERVICE_ROLE_KEY / sb_secret value from the deployment's own secrets
# store, never checked into this repo).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_xxx
