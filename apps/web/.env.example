# apps/web — Next.js app
#
# Local dev (`pnpm --filter @verity/web dev`): copy this to apps/web/.env.local and fill in.
# Cloudflare Workers Builds (production/demo deploy): do NOT put real values in a committed
# file. Set these same two names as "Build variables and secrets" in the Cloudflare dashboard
# (Worker → Settings → Build), because Next.js inlines NEXT_PUBLIC_* values at *build* time —
# a runtime-only Cloudflare "Variable" set after the build would not reach the browser bundle.
#
# Values come from Supabase Dashboard → Project Settings → API.
# The publishable key is meant to be public (safe in a browser bundle); access control is
# enforced entirely by Postgres RLS, never by keeping this key secret. Never use the
# `sb_secret_...` / service_role key here — that belongs only on the bastion (see
# scripts/.env.example) and must never reach a browser-facing deployment.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
