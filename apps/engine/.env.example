# apps/engine — FastAPI engine
#
# Copy to apps/engine/.env for local runs (`uv run --project apps/engine uvicorn verity_engine.main:app --reload`).
# Loaded via pydantic-settings with prefix VERITY_ (see src/verity_engine/settings.py).
#
# There is deliberately no service_role / secret key setting here (rule 4, PLAN.md §10.1):
# the engine authenticates every request with the calling user's own JWT, verified against
# this Supabase project's JWKS (VERITY_SUPABASE_URL + /auth/v1/.well-known/jwks.json).
# Do not add one.

# Same Supabase project as apps/web's NEXT_PUBLIC_SUPABASE_URL.
VERITY_SUPABASE_URL=http://127.0.0.1:54321

# Must match the `aud` claim Supabase issues (default for all Supabase projects).
VERITY_JWT_AUDIENCE=authenticated
