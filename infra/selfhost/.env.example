# infra/selfhost — overrides for the upstream Supabase Docker Compose stack (production,
# Jakarta; PLAN.md D-01/D-02). Merge these into the upstream compose file's `.env`, do not
# check the filled-in version into git (this repo's .gitignore already excludes `.env`).
#
# `sh utils/add-new-auth-keys.sh --update-env` (run once, from the upstream compose checkout)
# generates JWT_KEYS/JWT_JWKS and appends them to .env; copy those two values in below rather
# than inventing them.

# ── Access token hook: issues tenant_id/app_role claims (rule 5) ──
GOTRUE_HOOK_CUSTOM_ACCESS_TOKEN_ENABLED=true
GOTRUE_HOOK_CUSTOM_ACCESS_TOKEN_URI=pg-functions://postgres/public/custom_access_token_hook

# ── TOTP MFA, required for notaris/partner/super_admin (REQ-GW-05) ──
GOTRUE_MFA_TOTP_ENROLL_ENABLED=true
GOTRUE_MFA_TOTP_VERIFY_ENABLED=true

# ── ES256 signing keys (generated by add-new-auth-keys.sh, not by hand) ──
# SECRET: private key material used to sign every JWT this office issues.
JWT_KEYS=
# Public: the derived public key set. Served at /auth/v1/.well-known/jwks.json; apps/web and
# apps/engine derive their JWKS URL from SUPABASE_URL / VERITY_SUPABASE_URL, so it is not set
# separately there. Safe to expose — that's the whole point of a JWKS endpoint.
JWT_JWKS=

# ── No public self sign-up; accounts are created via scripts/invite_user.py ──
DISABLE_SIGNUP=true

# ── Storage: S3-compatible object storage, in the same Jakarta region ──
STORAGE_BACKEND=s3
GLOBAL_S3_BUCKET=verity-documents-jakarta
REGION=ap-southeast-3
# GLOBAL_S3_ENDPOINT / GLOBAL_S3_FORCE_PATH_STYLE: only needed for a non-AWS S3-compatible
# backend; omit both when the bucket is AWS S3 in ap-southeast-3.
# SECRET: scope this IAM user to only this bucket, nothing else in the account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Public URLs the auth service redirects to after email/OAuth flows ──
API_EXTERNAL_URL=https://api.verity.internal
SITE_URL=https://app.verity.internal
