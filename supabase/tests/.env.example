# supabase/tests — RLS / append-only / RPC tests (pytest + psycopg)
#
# Optional. With no file/vars, `pnpm db:test` starts a throwaway Postgres 17 (Homebrew) per
# test session and tears it down after — nothing below is required for that path.
# Set VERITY_TEST_DATABASE_URL to point the same test suite at an already-running Postgres
# (a local `supabase start` stack, or CI's postgres service) instead of spawning one.

# postgresql://postgres:postgres@localhost:5432/postgres
VERITY_TEST_DATABASE_URL=

# Only needed if Postgres 17 binaries aren't at the default Homebrew path
# (/opt/homebrew/opt/postgresql@17/bin) or on $PATH.
PG_BIN=
