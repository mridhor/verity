{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verity.local/schemas/agent-event.schema.json",
  "title": "AgentEvent",
  "description": "One server-sent event from an agent run. Emitted identically by the scenario agent (web) and the future LangGraph engine (Python).",
  "anyOf": [
    { "$ref": "#/$defs/StepEvent" },
    { "$ref": "#/$defs/TextEvent" },
    { "$ref": "#/$defs/CitationEvent" },
    { "$ref": "#/$defs/TableEvent" },
    { "$ref": "#/$defs/ProposalEvent" },
    { "$ref": "#/$defs/NavigateEvent" },
    { "$ref": "#/$defs/SuggestionsEvent" },
    { "$ref": "#/$defs/DoneEvent" },
    { "$ref": "#/$defs/ErrorEvent" }
  ],
  "$defs": {
    "StepEvent": {
      "title": "StepEvent",
      "description": "A tool step the agent ran, shown in the collapsible step list (PRD-A-01).",
      "type": "object",
      "properties": {
        "type": { "const": "step" },
        "seq": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "status": { "type": "string", "enum": ["running", "done", "error"] }
      },
      "required": ["type", "seq", "id", "label", "status"],
      "additionalProperties": false
    },
    "TextEvent": {
      "title": "TextEvent",
      "description": "Text appended to a paragraph block. Citation markers look like [[c1]] and refer to CitationEvent.marker.",
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "seq": { "type": "integer", "minimum": 0 },
        "blockId": { "type": "string" },
        "delta": { "type": "string" },
        "unsupported": { "type": "boolean", "description": "Claim without any valid citation; the UI flags it instead of hiding it." }
      },
      "required": ["type", "seq", "blockId", "delta"],
      "additionalProperties": false
    },
    "CitationEvent": {
      "title": "CitationEvent",
      "description": "A citation target, re-validated by the server (exists and accessible) before it is sent (REQ-AI-06).",
      "type": "object",
      "properties": {
        "type": { "const": "citation" },
        "seq": { "type": "integer", "minimum": 0 },
        "marker": { "type": "string" },
        "target": { "$ref": "#/$defs/CitationTarget" }
      },
      "required": ["type", "seq", "marker", "target"],
      "additionalProperties": false
    },
    "CitationTarget": {
      "title": "CitationTarget",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["berkas", "akta", "person", "company", "document", "checklist", "schedule", "legal", "repertorium", "klapper"]
        },
        "id": { "type": "string", "format": "uuid" },
        "label": { "type": "string" },
        "href": { "type": "string" },
        "field": { "type": "string", "description": "Field to highlight, e.g. nik or address." }
      },
      "required": ["kind", "id", "label", "href"],
      "additionalProperties": false
    },
    "TableEvent": {
      "title": "TableEvent",
      "type": "object",
      "properties": {
        "type": { "const": "table" },
        "seq": { "type": "integer", "minimum": 0 },
        "blockId": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cells": { "type": "array", "items": { "type": "string" } },
              "tone": { "type": "string", "enum": ["ok", "warn", "bad"] }
            },
            "required": ["cells"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "seq", "blockId", "columns", "rows"],
      "additionalProperties": false
    },
    "ProposalEvent": {
      "title": "ProposalEvent",
      "description": "Proposed changes created for human approval. The agent never applies them (rule 1).",
      "type": "object",
      "properties": {
        "type": { "const": "proposal" },
        "seq": { "type": "integer", "minimum": 0 },
        "proposedChangeIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      },
      "required": ["type", "seq", "proposedChangeIds"],
      "additionalProperties": false
    },
    "NavigateEvent": {
      "title": "NavigateEvent",
      "type": "object",
      "properties": {
        "type": { "const": "navigate" },
        "seq": { "type": "integer", "minimum": 0 },
        "href": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["type", "seq", "href", "label"],
      "additionalProperties": false
    },
    "SuggestionsEvent": {
      "title": "SuggestionsEvent",
      "type": "object",
      "properties": {
        "type": { "const": "suggestions" },
        "seq": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["type", "seq", "items"],
      "additionalProperties": false
    },
    "DoneEvent": {
      "title": "DoneEvent",
      "type": "object",
      "properties": {
        "type": { "const": "done" },
        "seq": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "seq"],
      "additionalProperties": false
    },
    "ErrorEvent": {
      "title": "ErrorEvent",
      "type": "object",
      "properties": {
        "type": { "const": "error" },
        "seq": { "type": "integer", "minimum": 0 },
        "message": { "type": "string" }
      },
      "required": ["type", "seq", "message"],
      "additionalProperties": false
    }
  }
}
